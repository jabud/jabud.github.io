---
// Menú lateral colapsable. Items con icono + etiqueta; al colapsar (<<)
// quedan solo los iconos. La preferencia se guarda en localStorage
// (la init anti-parpadeo vive en el <head> de BaseLayout).
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');

const items = [
  {
    href: '/notas',
    label: 'notas',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  },
  {
    href: '/resenas',
    label: 'reseñas',
    icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  },
  {
    href: '/projects',
    label: 'proyectos',
    icon: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
  },
];
---

<aside class="sidebar">
  <ul class="nav-menu">
    {
      items.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            title={item.label}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
          >
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={item.icon}
            />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <button id="sidebar-toggle" class="collapse-btn" type="button" aria-label="Colapsar menú">
    <span class="collapse-chevron" aria-hidden="true"></span>
    <span class="collapse-label">colapsar</span>
  </button>
</aside>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('sidebar-toggle');
  btn?.addEventListener('click', () => {
    const collapsed = root.dataset.sidebar === 'collapsed';
    if (collapsed) {
      delete root.dataset.sidebar;
      try {
        localStorage.setItem('sidebar', 'expanded');
      } catch (e) {}
    } else {
      root.dataset.sidebar = 'collapsed';
      try {
        localStorage.setItem('sidebar', 'collapsed');
      } catch (e) {}
    }
  });
</script>
